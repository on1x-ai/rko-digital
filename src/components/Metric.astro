---
export interface Props {
  value: string | number;
  label: string;
  format?: 'number' | 'currency' | 'text';
}

const { value, label, format = 'number' } = Astro.props;

const formattedValue = format === 'currency' 
  ? `${value} ₽` 
  : format === 'number' 
    ? new Intl.NumberFormat('ru-RU').format(Number(value))
    : value;
---

<div class="flex flex-col items-center text-center">
  <div class="text-4xl md:text-5xl font-display font-bold tabular-nums text-[var(--text-primary)] mb-2">
    {formattedValue}
  </div>
  <div class="text-sm text-[var(--text-secondary)] font-text font-medium">
    {label}
  </div>
</div>