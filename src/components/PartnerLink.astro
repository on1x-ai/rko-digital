---
export interface Props {
  href: string;
  children: string;
}

const { href, children } = Astro.props;

// Определяем, является ли ссылка внутренней
const isInternalLink = href.startsWith('/') || href.startsWith('#');
const linkProps = isInternalLink 
  ? {} 
  : { 
      rel: 'nofollow sponsored noopener noreferrer',
      target: '_blank' 
    };
---

<a
  href={href}
  class="text-[var(--accent-primary)] underline hover:text-[var(--accent-hover)] transition-colors"
  {...linkProps}
  data-erid=""
>
  {children}
</a>