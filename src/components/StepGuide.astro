---
export interface Props {
  steps: Array<{
    step: number;
    title: string;
    description: string;
  }>;
}

const { steps } = Astro.props;
---

<div class="space-y-8">
  {steps.map((item) => (
    <div class="flex gap-6">
      <div class="flex-shrink-0">
        <div class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-2xl shadow-lg">
          {item.step}
        </div>
      </div>
      <div class="flex-1">
        <h3 class="text-xl font-bold text-gray-900 mb-3">
          {item.title}
        </h3>
        <p class="text-gray-700 leading-relaxed bg-gray-50 rounded-xl p-4 border border-gray-200">
          {item.description}
        </p>
      </div>
    </div>
  ))}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Как открыть расчётный счёт",
  "description": "Пошаговое руководство по выбору банка, подготовке документов, подаче заявки и настройке интеграций для digital‑предпринимателей.",
  "step": [
    {steps.map(step => ({
      "@type": "HowToStep",
      "position": step.step,
      "name": step.title,
      "text": step.description
    }))}
  ]
}
</script>