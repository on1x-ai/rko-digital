---
export interface Props {
  steps: {
    title: string;
    time?: string;
    description: string;
  }[];
}

const { steps } = Astro.props;
---

<div class="my-8 border-l-4 border-blue-500 pl-8 space-y-8">
  {steps.map((step, idx) => (
    <div class="relative">
      <div class="absolute -left-12 top-0 w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center font-bold">
        {idx + 1}
      </div>
      <div class="font-bold text-gray-900 text-lg">{step.title}</div>
      {step.time && (
        <div class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium mt-2">
          {step.time}
        </div>
      )}
      <div class="text-gray-700 mt-3">{step.description}</div>
    </div>
  ))}
</div>

