---
export interface Props {
  title: string;
  subtitle?: string;
  result: string;
}

const { title, subtitle, result } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
  <h3 class="text-xl font-bold text-gray-900 mb-2">{title}</h3>
  {subtitle && <div class="text-gray-600 mb-4">{subtitle}</div>}
  <ul class="space-y-3 mb-6">
    <slot />
  </ul>
  <div class="pt-4 border-t border-gray-200">
    <div class="text-sm text-gray-500 mb-1">Итог</div>
    <div class="text-2xl font-bold text-gray-900">{result}</div>
  </div>
</div>

