---
export interface Props {
  title: string;
  subtitle?: string;
  bullets?: string[];
  result: string;
  resultLabel?: string;
}

const { title, subtitle, bullets, result, resultLabel = 'Итог' } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
  <div class="mb-6">
    <h3 class="text-xl font-bold text-gray-900 mb-1">{title}</h3>
    {subtitle && <div class="text-gray-600 text-sm">{subtitle}</div>}
  </div>
  
  <ul class="space-y-3 mb-6">
    {bullets && bullets.length > 0 ? (
      bullets.map((bullet, idx) => (
        <li key={idx} class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 text-xs font-bold mt-0.5 flex-shrink-0">
            {idx + 1}
          </div>
          <span class="text-gray-700">{bullet}</span>
        </li>
      ))
    ) : (
      <slot />
    )}
  </ul>
  
  <div class="pt-5 border-t border-gray-200">
    <div class="text-sm text-gray-500 mb-2">{resultLabel}</div>
    <div class="text-lg font-bold text-gray-900 leading-tight">{result}</div>
  </div>
</div>

