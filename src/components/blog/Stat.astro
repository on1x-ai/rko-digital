---
export interface Props {
  value: string;
  label: string;
  hint?: string;
}

const { value, label, hint } = Astro.props;
---

<div class="text-center p-3 sm:p-4 bg-white border border-gray-200 rounded-xl shadow-sm min-w-0 overflow-hidden">
  <div class="text-xs sm:text-sm md:text-lg lg:text-xl font-bold text-gray-900 mb-1 sm:mb-2 whitespace-nowrap leading-tight">{value}</div>
  <div class="text-gray-700 font-medium text-xs sm:text-sm md:text-base break-words">{label}</div>
  {hint && <div class="text-xs sm:text-sm text-gray-500 mt-1 sm:mt-2">{hint}</div>}
</div>

