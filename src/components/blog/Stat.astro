---
export interface Props {
  value: string;
  label: string;
  hint?: string;
}

const { value, label, hint } = Astro.props;
---

<div class="text-center p-4 bg-white border border-gray-200 rounded-xl shadow-sm">
  <div class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">{value}</div>
  <div class="text-gray-700 font-medium">{label}</div>
  {hint && <div class="text-sm text-gray-500 mt-2">{hint}</div>}
</div>

<!-- Пример:
<Stat value="3%" label="УСН для IT" hint="льготная ставка" />
