---
export interface Props {
  title?: string;
}

const { title = 'Короткий ответ' } = Astro.props;
---

<div class="my-8 p-6 border-l-4 border-blue-500 bg-blue-50 rounded-r-xl">
  <div class="font-bold text-lg text-gray-900 mb-2">{title}</div>
  <div class="text-gray-700 leading-relaxed">
    <slot />
  </div>
</div>

