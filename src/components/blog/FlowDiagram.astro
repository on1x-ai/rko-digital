---
export interface Props {
  steps: {
    title: string;
    description?: string;
    type?: 'start' | 'process' | 'decision' | 'end';
  }[];
}

const { steps } = Astro.props;

const typeIcons = {
  start: '🚀',
  process: '⚙️',
  decision: '🤔',
  end: '✅',
};
---

<div class="my-8">
  <div class="hidden md:flex items-center justify-between relative">
    <!-- Горизонтальная линия -->
    <div class="absolute top-1/2 left-0 right-0 h-0.5 bg-gray-300 -translate-y-1/2 z-0"></div>
    
    {steps.map((step, idx) => (
      <div class="relative z-10 flex flex-col items-center text-center w-32">
        <div class="w-12 h-12 rounded-full bg-white border-4 border-blue-500 flex items-center justify-center text-2xl mb-3">
          {typeIcons[step.type || 'process']}
        </div>
        <div class="font-bold text-gray-900">{step.title}</div>
        {step.description && (
          <div class="text-sm text-gray-600 mt-2">{step.description}</div>
        )}
        {idx < steps.length - 1 && (
          <div class="absolute top-6 left-full w-16 h-0.5 bg-blue-500"></div>
        )}
      </div>
    ))}
  </div>
  
  <!-- Мобильная версия -->
  <div class="md:hidden space-y-6">
    {steps.map((step, idx) => (
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-500 flex items-center justify-center text-xl flex-shrink-0">
          {typeIcons[step.type || 'process']}
        </div>
        <div>
          <div class="font-bold text-gray-900">{step.title}</div>
          {step.description && (
            <div class="text-gray-600 mt-1">{step.description}</div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

