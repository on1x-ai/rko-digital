---
export interface Props {
  steps: {
    title: string;
    description?: string;
  }[];
  variant?: 'horizontal' | 'vertical';
}

const { steps, variant = 'horizontal' } = Astro.props;
---

<div class="my-12">
  {variant === 'horizontal' ? (
    <>
      <div class="hidden md:flex items-center justify-between relative">
        <!-- Чистая линия-соединитель -->
        <div class="absolute top-1/2 left-0 right-0 h-px bg-gray-200 -translate-y-1/2 z-0"></div>
        
        {steps.map((step, idx) => (
          <div class="relative z-10 flex flex-col items-center text-center w-32">
            <div class="w-12 h-12 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center text-lg font-bold text-gray-800 mb-3">
              {idx + 1}
            </div>
            <div class="font-bold text-gray-900 mb-1">{step.title}</div>
            {step.description && (
              <div class="text-sm text-gray-600 px-2">{step.description}</div>
            )}
          </div>
        ))}
      </div>
      
      <!-- Мобильная версия -->
      <div class="md:hidden space-y-8">
        {steps.map((step, idx) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center text-base font-bold text-gray-800 flex-shrink-0">
              {idx + 1}
            </div>
            <div class="flex-1">
              <div class="font-bold text-gray-900 mb-1">{step.title}</div>
              {step.description && (
                <div class="text-gray-600 text-sm">{step.description}</div>
              )}
            </div>
          </div>
        ))}
      </div>
    </>
  ) : (
    <div class="border-l-2 border-gray-200 pl-6 ml-2 space-y-10">
      {steps.map((step, idx) => (
        <div class="relative">
          <div class="absolute -left-8 top-0 w-6 h-6 rounded-full bg-white border-2 border-gray-800 flex items-center justify-center text-sm font-bold text-gray-800">
            {idx + 1}
          </div>
          <div class="font-bold text-gray-900 text-lg mb-1">{step.title}</div>
          {step.description && (
            <div class="text-gray-700">{step.description}</div>
          )}
        </div>
      ))}
    </div>
  )}
</div>

