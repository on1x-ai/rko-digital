---
export interface Props {
  mandatory: {
    title: string;
    description: string;
  }[];
  important: {
    title: string;
    description: string;
  }[];
}

const { mandatory, important } = Astro.props;
---

<div class="my-8">
  <div class="mb-10">
    <h3 class="font-bold text-gray-900 text-xl mb-6">Обязательные критерии:</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {mandatory.map((item, idx) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md transition-shadow duration-200">
          <div class="flex items-start gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 font-bold text-sm flex-shrink-0">
              {idx + 1}
            </div>
            <h4 class="font-bold text-gray-900">{item.title}</h4>
          </div>
          <p class="text-gray-600 text-sm pl-11">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
  
  <div>
    <h3 class="font-bold text-gray-900 text-xl mb-6">Важные, но не обязательные:</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {important.map((item, idx) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-md transition-shadow duration-200">
          <div class="flex items-start gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-600 font-bold text-sm flex-shrink-0">
              {mandatory.length + idx + 1}
            </div>
            <h4 class="font-bold text-gray-900">{item.title}</h4>
          </div>
          <p class="text-gray-600 text-sm pl-11">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>

