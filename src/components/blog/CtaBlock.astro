---
import CTAButton from '../CTAButton.astro';

export interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Нужна помощь с выбором?',
  text = 'Оставьте заявку, и мы бесплатно подберём для вас расчётный счёт с эквайрингом и валютным контролем.',
  primaryLabel = 'Подобрать банк',
  primaryHref = '/comparison',
  secondaryLabel,
  secondaryHref = '/#consult',
} = Astro.props;
---

<div class="my-12 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 md:p-10 text-center">
  <h3 class="text-3xl font-bold text-gray-900 mb-4">{title}</h3>
  {text && <p class="text-gray-700 mb-8 max-w-2xl mx-auto">{text}</p>}
  <div class="flex flex-col sm:flex-row gap-4 justify-center">
    <CTAButton href={primaryHref} variant="primary" size="lg">
      {primaryLabel}
    </CTAButton>
    {secondaryLabel && (
      <CTAButton href={secondaryHref} variant="outline" size="lg">
        {secondaryLabel}
      </CTAButton>
    )}
  </div>
</div>

