---
export interface Props {
  items: Array<{
    question: string;
    answer: string;
  }>;
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item, idx) => (
    <div class="border border-gray-200 rounded-xl bg-white overflow-hidden">
      <input type="checkbox" id={`faq-${idx}`} class="hidden peer" />
      <label for={`faq-${idx}`} class="flex items-center justify-between cursor-pointer p-6 hover:bg-gray-50 transition-colors">
        <h3 class="text-lg font-semibold text-gray-900 pr-8">
          {item.question}
        </h3>
        <svg class="w-5 h-5 text-gray-500 transition-transform peer-checked:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </label>
      <div class="px-6 pb-6 pt-0 max-h-0 overflow-hidden transition-all duration-300 peer-checked:max-h-96 peer-checked:pb-6">
        <p class="text-gray-600 leading-relaxed">
          {item.answer}
        </p>
      </div>
    </div>
  ))}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {items.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))}
  ]
}
</script>