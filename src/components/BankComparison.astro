---
import banksData from '../data/banks.json';
import CTAButton from './CTAButton.astro';

export interface Props {
  banks?: typeof banksData.banks;
}

const { banks = banksData.banks } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b border-[var(--border-strong)]">
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold">Банк</th>
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold">Открытие</th>
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold">Обслуживание</th>
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold">Платежи</th>
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold">Валюта</th>
        <th class="text-left py-4 px-6 text-[var(--text-secondary)] font-text font-semibold"></th>
      </tr>
    </thead>
    <tbody>
      {banks.map((bank) => (
        <tr class="border-b border-[var(--border-subtle)] hover:bg-[var(--bg-hover)] transition-colors">
          <td class="py-4 px-6">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 bg-[var(--bg-elevated)] rounded-card flex items-center justify-center text-[var(--text-primary)] font-display font-bold">
                {bank.name.charAt(0)}
              </div>
              <div>
                <div class="font-display font-bold text-[var(--text-primary)]">{bank.name}</div>
                <div class="text-sm text-[var(--text-secondary)]">{bank.bestFor}</div>
              </div>
            </div>
          </td>
          <td class="py-4 px-6">
            <div class="text-[var(--text-primary)] font-display font-bold tabular-nums">{bank.openingTime}</div>
            <div class="text-sm text-[var(--text-secondary)]">{bank.openingCost}</div>
          </td>
          <td class="py-4 px-6">
            <div class="text-[var(--text-primary)] font-display font-bold tabular-nums">{bank.monthlyFee.start}</div>
            <div class="text-sm text-[var(--text-secondary)]">далее {bank.monthlyFee.standard}</div>
          </td>
          <td class="py-4 px-6">
            <div class="text-[var(--text-primary)] font-display font-bold tabular-nums">{bank.perPayment}</div>
            <div class="text-sm text-[var(--text-secondary)]">снятие {bank.cashWithdrawal}</div>
          </td>
          <td class="py-4 px-6">
            <div class="text-[var(--text-primary)] font-display font-bold tabular-nums">
              {bank.currencyControl ? 'SWIFT' : '₽'}
            </div>
            <div class="text-sm text-[var(--text-secondary)]">
              {bank.swift ? 'Валютный контроль' : 'Только рубль'}
            </div>
          </td>
          <td class="py-4 px-6">
            <CTAButton href={bank.partnerLink} size="sm">
              Открыть
            </CTAButton>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Мобильная версия -->
<div class="hidden max-sm:block space-y-4">
  {banks.map((bank) => (
    <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-card p-4">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-[var(--bg-elevated)] rounded-card flex items-center justify-center text-[var(--text-primary)] font-display font-bold">
            {bank.name.charAt(0)}
          </div>
          <div>
            <div class="font-display font-bold text-[var(--text-primary)]">{bank.name}</div>
            <div class="text-sm text-[var(--text-secondary)]">{bank.bestFor}</div>
          </div>
        </div>
        <div class="text-right">
          <div class="text-[var(--text-primary)] font-display font-bold tabular-nums">{bank.rating}</div>
          <div class="text-xs text-[var(--text-secondary)]">{bank.reviewCount} отзывов</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <div class="text-xs text-[var(--text-secondary)]">Открытие</div>
          <div class="text-lg font-display font-bold tabular-nums text-[var(--text-primary)]">
            {bank.openingTime}
          </div>
        </div>
        <div>
          <div class="text-xs text-[var(--text-secondary)]">Обслуживание</div>
          <div class="text-lg font-display font-bold tabular-nums text-[var(--text-primary)]">
            {bank.monthlyFee.start}
          </div>
        </div>
        <div>
          <div class="text-xs text-[var(--text-secondary)]">Платежи</div>
          <div class="text-lg font-display font-bold tabular-nums text-[var(--text-primary)]">
            {bank.perPayment}
          </div>
        </div>
        <div>
          <div class="text-xs text-[var(--text-secondary)]">Валюта</div>
          <div class="text-lg font-display font-bold tabular-nums text-[var(--text-primary)]">
            {bank.currencyControl ? 'SWIFT' : '₽'}
          </div>
        </div>
      </div>

      <CTAButton href={bank.partnerLink} fullWidth>
        Открыть счёт в {bank.name}
      </CTAButton>
    </div>
  ))}
</div>