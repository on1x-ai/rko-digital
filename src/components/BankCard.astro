---
import CTAButton from './CTAButton.astro';

export interface Props {
  bank: {
    name: string;
    slug: string;
    partnerLink: string;
    features: string[];
    monthlyFee: { start: string; standard: string; pro: string };
    openingTime: string;
    currencyControl: boolean;
    bestFor: string;
    pros: string[];
    cons: string[];
    rating: number;
    reviewCount: number;
  };
  featured?: boolean;
  reason?: string;
  bestFor?: string;
}

const { bank, featured = false, reason, bestFor } = Astro.props;
---

<article class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-card p-6 hover:bg-[var(--bg-hover)] hover:border-[var(--border-strong)] transition-all">
  <header class="flex items-start justify-between mb-6">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 bg-[var(--bg-elevated)] rounded-card flex items-center justify-center text-[var(--text-primary)] font-display font-bold">
          {bank.name.charAt(0)}
        </div>
        <h3 class="text-2xl font-display font-bold text-[var(--text-primary)]">
          {bank.name}
        </h3>
      </div>
      <p class="text-[var(--text-secondary)]">
        {reason || bank.bestFor}
      </p>
    </div>
    {featured && (
      <span class="inline-flex items-center px-3 py-1 rounded-pill bg-[var(--accent-primary)] text-[var(--text-inverse)] text-xs font-semibold">
        Выбор редакции
      </span>
    )}
  </header>

  <div class="border-t border-[var(--border-subtle)] pt-6 mb-6">
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div>
        <div class="text-sm text-[var(--text-secondary)] mb-1">Открытие</div>
        <div class="text-xl font-display font-bold tabular-nums text-[var(--text-primary)]">
          {bank.openingTime}
        </div>
      </div>
      <div>
        <div class="text-sm text-[var(--text-secondary)] mb-1">Обслуживание</div>
        <div class="text-xl font-display font-bold tabular-nums text-[var(--text-primary)]">
          {bank.monthlyFee.start}
        </div>
      </div>
      <div>
        <div class="text-sm text-[var(--text-secondary)] mb-1">Валюта</div>
        <div class="text-xl font-display font-bold tabular-nums text-[var(--text-primary)]">
          {bank.currencyControl ? 'SWIFT' : '₽'}
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--border-subtle)] pt-6">
      <h4 class="text-sm font-semibold text-[var(--text-secondary)] mb-3">Особенности</h4>
      <ul class="space-y-2">
        {bank.features.slice(0, 3).map((feature, idx) => (
          <li class="flex items-center gap-2 text-[var(--text-primary)]">
            <svg class="w-4 h-4 text-[var(--accent-primary)]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <div class="text-sm text-[var(--text-secondary)]">
      <span class="font-semibold text-[var(--text-primary)]">{bank.rating}</span> / 5 • {bank.reviewCount} отзывов
    </div>
    <CTAButton href={bank.partnerLink} variant={featured ? 'primary' : 'secondary'}>
      Открыть счёт →
    </CTAButton>
  </div>
</article>