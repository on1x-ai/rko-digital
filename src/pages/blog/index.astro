---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime, formatReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  return [{ params: { slug: 'index' } }];
}

const blogPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Сортируем по дате (новые сначала)
const sortedPosts = blogPosts.sort((a, b) => 
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Функция для получения категории по нише
function getCategory(niche) {
  const categories = {
    'it-specialisty': 'IT-специалисты',
    'startup': 'Стартапы',
    'freelancers': 'Фрилансеры',
    'online-school': 'Онлайн-школы',
    'ecommerce': 'E-commerce',
    'digital-agency': 'Digital-агентства',
  };
  return categories[niche] || 'Банковские услуги';
}
---

<BaseLayout title="Блог о банках для IT и digital" description="Практические руководства по выбору банков, налоговому учёту и валютным операциям для разработчиков, дизайнеров и предпринимателей.">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Блог RKO.digital</h1>
      <p class="text-xl text-gray-600">
        Практические руководства по банковским услугам, налогам и валютным операциям для IT‑специалистов, фрилансеров и digital‑предпринимателей.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => {
        const readTimeMinutes = readingTime(post.body, post.id);
        const readTimeDisplay = formatReadingTime(readTimeMinutes);
        const category = getCategory(post.data.niche);
        
        return (
          <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <a href={`/blog/${post.id}`} class="block">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
                    {category}
                  </span>
                  <span class="text-sm text-gray-500">
                    {readTimeDisplay}
                  </span>
                </div>
                
                <h2 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                  {post.data.title}
                </h2>
                
                <p class="text-gray-600 mb-4 line-clamp-3">
                  {post.data.description}
                </p>
                
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                      <span class="text-gray-600 text-sm font-medium">
                        {post.data.author.charAt(0)}
                      </span>
                    </div>
                    <span class="text-sm text-gray-700">{post.data.author}</span>
                  </div>
                  
                  <time class="text-sm text-gray-500" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ru-RU', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric'
                    })}
                  </time>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Не нашли ответ на свой вопрос?</h2>
        <p class="text-gray-600 mb-6">
          Наши эксперты помогут подобрать оптимальный банк, разобраться с налогами и настроить валютные операции под вашу бизнес‑модель.
        </p>
        <a href="/#consult" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors duration-300">
          Получить консультацию
        </a>
      </div>
    </div>
  </div>
</BaseLayout>