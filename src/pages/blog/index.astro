---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import AdBlock from '../../components/AdBlock.astro';
import CTAButton from '../../components/CTAButton.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const postsPerPage = 6;
const page = Astro.url.searchParams.get('page') || '1';
const currentPage = Number(page) || 1;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = sortedPosts.slice(startIndex, endIndex);
---

<BaseLayout
  title="Блог о РКО для digital‑предпринимателей"
  description="Статьи о выборе расчётного счёта, эквайринге, валютном контроле и налогах для IT‑специалистов, фрилансеров, стартапов и онлайн‑школ."
  canonical="/blog/"
>
  <div class="container mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Блог о РКО для digital‑предпринимателей
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl">
        Практические руководства по выбору банка, снижению комиссий и легальному приёму платежей от зарубежных заказчиков.
      </p>
    </header>

    <AdBlock slot="top" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {
        paginatedPosts.map((post) => {
          const nicheColor = {
            'it-specialisty': 'from-blue-500 to-cyan-500',
            'startup': 'from-purple-500 to-pink-500',
            'freelancers': 'from-green-500 to-emerald-500',
            'online-school': 'from-amber-500 to-orange-500',
            'ecommerce': 'from-red-500 to-rose-500',
            'digital-agency': 'from-indigo-500 to-violet-500',
          }[post.data.niche || 'it-specialisty'];
          return (
            <article class="group bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 overflow-hidden border border-gray-100 hover:border-blue-200">
              <div class={`h-2 bg-gradient-to-r ${nicheColor}`} />
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-semibold px-3 py-1 rounded-full bg-gray-100 text-gray-800 uppercase tracking-wide">
                    {post.data.niche === 'it-specialisty' && '💻 IT‑специалисты'}
                    {post.data.niche === 'startup' && '🚀 Стартапы'}
                    {post.data.niche === 'freelancers' && '👨‍💻 Фриланс'}
                    {post.data.niche === 'online-school' && '🎓 Онлайн‑школы'}
                    {post.data.niche === 'ecommerce' && '🛒 E‑commerce'}
                    {post.data.niche === 'digital-agency' && '🏢 Digital‑агентства'}
                  </span>
                  <time class="text-sm text-gray-500 font-medium" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ru-RU', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4 leading-tight group-hover:text-blue-700 transition-colors">
                  <a
                    href={`/blog/${post.id}/`}
                    class="hover:underline decoration-2 decoration-blue-500"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-gray-600 mb-6 line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-r from-blue-400 to-cyan-400 flex items-center justify-center text-white text-sm font-bold">
                      {post.data.author.charAt(0)}
                    </div>
                    <span class="text-sm text-gray-700 font-medium">{post.data.author}</span>
                  </div>
                  <a
                    href={`/blog/${post.id}/`}
                    class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-semibold text-sm group/read"
                  >
                    Читать подробнее
                    <svg class="w-4 h-4 group-hover/read:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    {
      totalPages > 1 && (
        <nav class="flex justify-center items-center gap-4 mb-12">
          {
            currentPage > 1 && (
              <a
                href={`/blog/?page=${currentPage - 1}`}
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
              >
                ← Назад
              </a>
            )
          }
          <span class="text-gray-600">
            Страница {currentPage} из {totalPages}
          </span>
          {
            currentPage < totalPages && (
              <a
                href={`/blog/?page=${currentPage + 1}`}
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
              >
                Вперёд →
              </a>
            )
          }
        </nav>
      )
    }

    <AdBlock slot="middle" />

    <section class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 mb-12">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Нужна помощь с выбором банка?
        </h2>
        <p class="text-gray-700 mb-8">
          Оставьте заявку, и мы бесплатно подберём для вас расчётный счёт с эквайрингом и валютным контролем.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <CTAButton href="/#consult" variant="primary">
            Бесплатная консультация
          </CTAButton>
          <CTAButton href="/#comparison" variant="outline">
            Сравнить банки
          </CTAButton>
        </div>
      </div>
    </section>

    <AdBlock slot="bottom" />
  </div>
</BaseLayout>