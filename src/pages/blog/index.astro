---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import AdBlock from '../../components/AdBlock.astro';
import CTAButton from '../../components/CTAButton.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const postsPerPage = 6;
const page = Astro.url.searchParams.get('page') || '1';
const currentPage = Number(page) || 1;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
const startIndex = (currentPage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = sortedPosts.slice(startIndex, endIndex);
---

<BaseLayout
  title="Блог о РКО для digital‑предпринимателей"
  description="Статьи о выборе расчётного счёта, эквайринге, валютном контроле и налогах для IT‑специалистов, фрилансеров, стартапов и онлайн‑школ."
  canonical="/blog/"
>
  <div class="container mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Блог о РКО для digital‑предпринимателей
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl">
        Практические руководства по выбору банка, снижению комиссий и легальному приёму платежей от зарубежных заказчиков.
      </p>
    </header>

    <AdBlock slot="top" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {
        paginatedPosts.map((post) => (
          <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-100">
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <span class="text-sm font-medium px-3 py-1 rounded-full bg-blue-50 text-blue-700">
                  {post.data.niche === 'it-specialisty' && 'IT‑специалисты'}
                  {post.data.niche === 'startup' && 'Стартапы'}
                  {post.data.niche === 'freelancers' && 'Фриланс'}
                  {post.data.niche === 'online-school' && 'Онлайн‑школы'}
                  {post.data.niche === 'ecommerce' && 'E‑commerce'}
                  {post.data.niche === 'digital-agency' && 'Digital‑агентства'}
                </span>
                <time class="text-sm text-gray-500" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('ru-RU', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-2xl font-bold text-gray-900 mb-3">
                <a
                  href={`/blog/${post.id}/`}
                  class="hover:text-blue-600 transition-colors duration-200"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-600 mb-6 line-clamp-3">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">{post.data.author}</span>
                <a
                  href={`/blog/${post.id}/`}
                  class="text-blue-600 hover:text-blue-800 font-medium text-sm inline-flex items-center gap-1"
                >
                  Читать
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav class="flex justify-center items-center gap-4 mb-12">
          {
            currentPage > 1 && (
              <a
                href={`/blog/?page=${currentPage - 1}`}
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
              >
                ← Назад
              </a>
            )
          }
          <span class="text-gray-600">
            Страница {currentPage} из {totalPages}
          </span>
          {
            currentPage < totalPages && (
              <a
                href={`/blog/?page=${currentPage + 1}`}
                class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors"
              >
                Вперёд →
              </a>
            )
          }
        </nav>
      )
    }

    <AdBlock slot="middle" />

    <section class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 mb-12">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Нужна помощь с выбором банка?
        </h2>
        <p class="text-gray-700 mb-8">
          Оставьте заявку, и мы бесплатно подберём для вас расчётный счёт с эквайрингом и валютным контролем.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <CTAButton href="/#consult" variant="primary">
            Бесплатная консультация
          </CTAButton>
          <CTAButton href="/#comparison" variant="outline">
            Сравнить банки
          </CTAButton>
        </div>
      </div>
    </section>

    <AdBlock slot="bottom" />
  </div>
</BaseLayout>