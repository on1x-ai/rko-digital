---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { readingTime, formatReadingTime } from '../../utils/readingTime';

// Импортируем все компоненты блога
import AnswerCallout from '../../components/blog/AnswerCallout.astro';
import Stat from '../../components/blog/Stat.astro';
import StatRow from '../../components/blog/StatRow.astro';
import CompareTable from '../../components/blog/CompareTable.astro';
import ScenarioCard from '../../components/blog/ScenarioCard.astro';
import ScenarioGrid from '../../components/blog/ScenarioGrid.astro';
import FlowDiagram from '../../components/blog/FlowDiagram.astro';
import StepTimeline from '../../components/blog/StepTimeline.astro';
import BarCompare from '../../components/blog/BarCompare.astro';
import Callout from '../../components/blog/Callout.astro';
import Checklist from '../../components/blog/Checklist.astro';
import CtaBlock from '../../components/blog/CtaBlock.astro';
import ProsCons from '../../components/blog/ProsCons.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.id },
    props: { slug: post.id },
  }));
}

const { slug } = Astro.props;
const post = await getEntry('blog', slug);

// Для MDX используем render() для получения контента
const { Content } = await render(post);

// Вычисляем время чтения
const readTimeMinutes = readingTime(post.body ?? '');
const readTimeDisplay = formatReadingTime(readTimeMinutes);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <header class="mb-8">
      <div class="flex items-center gap-4 mb-4">
        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
          {post.data.niche ? 
            post.data.niche === 'it-specialisty' ? 'IT-специалисты' :
            post.data.niche === 'startup' ? 'Стартапы' :
            post.data.niche === 'freelancers' ? 'Фрилансеры' :
            post.data.niche === 'online-school' ? 'Онлайн-школы' :
            post.data.niche === 'ecommerce' ? 'E-commerce' :
            post.data.niche === 'digital-agency' ? 'Digital-агентства' :
            post.data.niche
          : 'Банковские услуги'}
        </span>
        <time class="text-gray-600" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          })}
        </time>
        <span class="text-gray-600">•</span>
        <span class="text-gray-600">{readTimeDisplay}</span>
      </div>
      
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{post.data.title}</h1>
      <p class="text-xl text-gray-600 mb-6">{post.data.description}</p>
      
      <div class="border-t border-b border-gray-200 py-4 mb-6">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center">
            <span class="text-gray-600 font-bold">
              {post.data.author.split(' ').map(n => n[0]).join('')}
            </span>
          </div>
          <div>
            <div class="font-medium text-gray-900">{post.data.author}</div>
          </div>
        </div>
      </div>
    </header>

    <div class="prose prose-lg prose-blue max-w-none">
      <Content 
        components={{
          AnswerCallout,
          Stat,
          StatRow,
          CompareTable,
          ScenarioCard,
          ScenarioGrid,
          FlowDiagram,
          StepTimeline,
          BarCompare,
          Callout,
          Checklist,
          CtaBlock,
          ProsCons,
        }}
      />
    </div>
  </article>
</BaseLayout>