---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import AdBlock from '../../components/AdBlock.astro';
import CTAButton from '../../components/CTAButton.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { Markdown } from 'astro:components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const entry = await getEntry('blog', slug!);
const posts = await getCollection('blog');

if (!entry) {
  return Astro.redirect('/404');
}

const relatedPosts = posts
  .filter((post) => post.slug !== slug && post.data.niche === entry.data.niche)
  .slice(0, 3);

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`/blog/${slug}/`}
  image={entry.data.image}
  pubDate={entry.data.pubDate}
  author={entry.data.author}
  type="article"
>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <article class="mb-12">
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="text-sm font-medium px-3 py-1 rounded-full bg-gradient-to-r from-blue-500 to-cyan-500 text-white">
            {
              entry.data.niche === 'it-specialisty' && '💻 IT‑специалисты'
              || entry.data.niche === 'startup' && '🚀 Стартапы'
              || entry.data.niche === 'freelancers' && '👨‍💻 Фриланс'
              || entry.data.niche === 'online-school' && '🎓 Онлайн‑школы'
              || entry.data.niche === 'ecommerce' && '🛒 E‑commerce'
              || entry.data.niche === 'digital-agency' && '🏢 Digital‑агентства'
              || 'Digital'
            }
          </span>
          <time class="text-sm text-gray-500 font-medium" datetime={entry.data.pubDate.toISOString()}>
            📅 {entry.data.pubDate.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          <span class="text-sm text-gray-500">•</span>
          <span class="text-sm text-gray-700 font-medium">👤 {entry.data.author}</span>
          <span class="text-sm text-gray-500">•</span>
          <span class="text-sm text-gray-700 font-medium">⏱️ Время чтения: ~7 мин</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {entry.data.title}
        </h1>
        <p class="text-xl text-gray-600 border-l-4 border-blue-500 pl-4 py-2 bg-blue-50 rounded-r-xl">
          {entry.data.description}
        </p>
        
        <!-- Блок "Поделиться" -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <span class="text-gray-700 font-medium">Поделиться:</span>
          <div class="flex gap-2">
            <a href="#" class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center hover:bg-blue-200 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center hover:bg-gray-200 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.213c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
            <a href="#" class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center hover:bg-red-200 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </header>

      <AdBlock slot="top" />

      <div class="max-w-none mb-12">
        <div class="prose prose-lg prose-blue max-w-none">
          <Content />
        </div>
        
        <!-- Дополнительные визуальные элементы -->
        <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">📊 Ключевые выводы</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700">Выберите банк с упрощённым валютным контролем для работы с зарубежными заказчиками</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700">Используйте код ОКВЭД 62.01 для льготной УСН 3%</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center flex-shrink-0">✓</div>
                <span class="text-gray-700">Открывайте счёт онлайн — это занимает от 15 минут до 1 дня</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">📈 Сравнение комиссий (средние по рынку)</h3>
            <div class="space-y-4">
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-700">SWIFT‑переводы</span>
                  <span class="font-bold text-gray-900">0,5% – 2%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full" style="width: 70%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-700">Эквайринг</span>
                  <span class="font-bold text-gray-900">1,9% – 2,5%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-blue-500 h-2 rounded-full" style="width: 85%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-700">Обслуживание счёта</span>
                  <span class="font-bold text-gray-900">0 – 990 ₽/мес</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-purple-500 h-2 rounded-full" style="width: 60%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Таблица сравнения для статьи -->
        <div class="mt-12">
          <h3 class="text-3xl font-bold text-gray-900 mb-6">🏦 Сравнение банков для {entry.data.niche === 'it-specialisty' && 'IT‑специалистов' || entry.data.niche === 'startup' && 'стартапов' || entry.data.niche === 'freelancers' && 'фрилансеров' || entry.data.niche === 'online-school' && 'онлайн‑школ' || entry.data.niche === 'ecommerce' && 'e‑commerce' || entry.data.niche === 'digital-agency' && 'digital‑агентств'}</h3>
          <div class="overflow-x-auto rounded-2xl border border-gray-200">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="text-left p-4 font-bold text-gray-700">Банк</th>
                  <th class="text-left p-4 font-bold text-gray-700">Срок одобрения</th>
                  <th class="text-left p-4 font-bold text-gray-700">Обслуживание</th>
                  <th class="text-left p-4 font-bold text-gray-700">SWIFT</th>
                  <th class="text-left p-4 font-bold text-gray-700">Рекомендация</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr class="hover:bg-blue-50">
                  <td class="p-4 font-bold text-gray-900">Т‑Банк</td>
                  <td class="p-4">1 день</td>
                  <td class="p-4">0 ₽ первые 2 месяца</td>
                  <td class="p-4">✅ Да</td>
                  <td class="p-4"><span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">Для начинающих</span></td>
                </tr>
                <tr class="hover:bg-blue-50">
                  <td class="p-4 font-bold text-gray-900">Альфа‑Банк</td>
                  <td class="p-4">1–2 дня</td>
                  <td class="p-4">0 ₽ при обороте до 1 млн ₽</td>
                  <td class="p-4">✅ Да</td>
                  <td class="p-4"><span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">Для опытных</span></td>
                </tr>
                <tr class="hover:bg-blue-50">
                  <td class="p-4 font-bold text-gray-900">Тинькофф Бизнес</td>
                  <td class="p-4">1 день</td>
                  <td class="p-4">0 ₽ первые 3 месяца</td>
                  <td class="p-4">✅ Да</td>
                  <td class="p-4"><span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium">Для e‑commerce</span></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-gray-500 text-sm mt-4">*Данные актуальны на октябрь 2026 года. Подробное сравнение на <a href="/comparison/" class="text-blue-600 hover:underline">странице сравнения</a>.</p>
        </div>
      </div>

      <AdBlock slot="middle" />

      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 mb-12">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Нужна помощь с выбором банка?
          </h2>
          <p class="text-gray-700 mb-8">
            Оставьте заявку, и мы бесплатно подберём для вас расчётный счёт с эквайрингом и валютным контролем.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <CTAButton href="/#consult" variant="primary">
              Бесплатная консультация
            </CTAButton>
            <CTAButton href="/#comparison" variant="outline">
              Сравнить банки
            </CTAButton>
          </div>
        </div>
      </div>

      <AdBlock slot="bottom" />
    </article>

    {
      relatedPosts.length > 0 && (
        <RelatedArticles articles={relatedPosts} />
      )
    }

    <section class="border-t border-gray-200 pt-12 mt-12">
      <div class="text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          Понравилась статья?
        </h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
          Подпишитесь на рассылку, чтобы получать новые статьи о РКО, эквайринге и налогах для digital‑предпринимателей.
        </p>
        <form
          class="max-w-md mx-auto flex flex-col sm:flex-row gap-3"
          action="https://formspree.io/f/your-form-id"
          method="POST"
        >
          <input
            type="email"
            name="email"
            placeholder="Ваш email"
            required
            class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap"
          >
            Подписаться
          </button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>