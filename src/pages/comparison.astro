---
import BaseLayout from '../layouts/BaseLayout.astro';
import BankComparison from '../components/BankComparison.astro';
import AdBlock from '../components/AdBlock.astro';
import CTAButton from '../components/CTAButton.astro';

const pageTitle = 'Сравнение банков для digital‑предпринимателей';
const pageDescription = 'Подробное сравнение тарифов, комиссий, сроков одобрения и плюшек от банков. Выберите лучший расчётный счёт для IT‑специалистов, фрилансеров, стартапов, онлайн‑школ и e‑commerce.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/comparison/"
>
  <main class="container mx-auto px-4 sm:px-5 py-12 max-w-7xl overflow-x-hidden">
    <header class="mb-12 text-center px-4 sm:px-5">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 break-words">
        Сравнение банков
      </h1>
      <p class="text-xl text-gray-600 max-w-4xl mx-auto">
        Подробная таблица с тарифами, комиссиями, сроками одобрения и специальными предложениями для digital‑предпринимателей. Данные ориентировочные, уточняйте на стороне банка. Актуально: октябрь 2026.
      </p>
    </header>

    <AdBlock slot="top" />

    <div class="mb-8 bg-blue-50 rounded-2xl p-6 md:p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Как пользоваться сравнением</h2>
      <div class="space-y-4 text-gray-700">
        <div>
          <h3 class="font-semibold text-lg mb-2">Что такое РКО</h3>
          <p>РКО (расчётно-кассовое обслуживание) — банковское обслуживание расчётного счёта бизнеса (ИП или ООО). На этот счёт приходят оплаты от клиентов, с него платят подрядчикам и налоги, к нему подключают эквайринг. Без расчётного счёта сложно полноценно работать с юрлицами.</p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Чем отличается «просто счёт» от «регистрация + счёт»</h3>
          <div class="grid md:grid-cols-2 gap-4 mt-3">
            <div class="bg-white p-4 rounded-xl border border-blue-200">
              <div class="font-bold text-blue-700 mb-2">Уже есть ИП или ООО</div>
              <p>Выбирайте банки с подписью «Только расчётный счёт» или «Счёт для ИП/ООО».</p>
            </div>
            <div class="bg-white p-4 rounded-xl border border-green-200">
              <div class="font-bold text-green-700 mb-2">Ещё не регистрировали бизнес</div>
              <p>Берите варианты «Регистрация бизнеса + счёт»: помогут оформить ИП/ООО и сразу открыть счёт.</p>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Одинаковые названия банка</h3>
          <p>Две строки «Альфа-Банк» или две «ПСБ» — это разные сценарии. Смотрите подзаголовок (тип продукта) и колонку «Для кого».</p>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <BankComparison />
      <div class="mt-8 text-center text-gray-500 text-sm">
        <p>💡 <strong>Партнёрские ссылки:</strong> При открытии счёта по нашим ссылкам вы получаете дополнительные бонусы (повышенный кэшбэк, бесплатные месяцы обслуживания, персонального менеджера). Это не влияет на стоимость услуг для вас — банк платит нам за рекомендацию.</p>
      </div>
    </div>

    <AdBlock slot="middle" />

    <section class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 mb-12">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Нужна помощь с выбором?
        </h2>
        <p class="text-gray-700 mb-8">
          Оставьте заявку, и мы бесплатно подберём для вас расчётный счёт с эквайрингом и валютным контролем.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <CTAButton href="https://t.me/rkodijital_bot" variant="primary">
            Бесплатная консультация
          </CTAButton>
          <CTAButton href="/" variant="outline">
            На главную
          </CTAButton>
        </div>
      </div>
    </section>

    <AdBlock slot="bottom" />
  </main>
</BaseLayout>